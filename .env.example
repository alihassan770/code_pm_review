# Environment variables for a container deployment (Railway, Fly, Docker).
# On a laptop none of these are needed — the app writes
# ~/.config/odoo-qa-gate/config.yaml on first run instead.
#
# Environment always wins over the config file.

# Provided automatically by Railway when you attach a Postgres service.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# REQUIRED in a container. Encrypts every client's Odoo credentials at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored client credential undecryptable, so set it
# once and keep it. A container has no persistent filesystem, so without this
# a fresh key is minted on every deploy and all stored credentials are orphaned.
QA_GATE_SECRET_KEY=

# The Odoo that holds your team's user accounts. Staff sign in against it.
# Set these and the /setup page is skipped entirely — which is what you want in
# a container, because /setup writes to a file that does not survive a redeploy.
QA_GATE_ODOO_URL=https://odoo.example.com
QA_GATE_ODOO_DB=production

# Set true whenever the app is served over HTTPS. Railway terminates TLS for
# you, so this should be true there. Leave false on plain http://localhost or
# the session cookie will be dropped and login will appear to silently fail.
QA_GATE_SECURE_COOKIES=true

# Optional.
QA_GATE_SESSION_HOURS=12
